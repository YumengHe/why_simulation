<?xml version="1.0"?>
<!-- Teaching model: geometry is saved in the parent frame, in meters.
     Collision and inertia are intentionally omitted. -->
<robot name="hinged_panel">
  <link name="base" />
  <link name="door">
    <visual>
      <origin xyz="-1 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="door-parent-frame.obj" />
      </geometry>
    </visual>
  </link>
  <joint name="door_hinge" type="revolute">
    <parent link="base" />
    <child link="door" />
    <origin xyz="1 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="1.570796" effort="10" velocity="1" />
  </joint>
</robot>
